---
import Layout from "../layouts/main.astro";
---

<Layout>
  <div class="h-screen w-full overflow-hidden relative bg-black text-white font-mono">
    
    <!-- Grid overlay -->
    <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 40px 40px;"></div>
    
    <!-- Diagonal stripe -->
    <div class="absolute top-0 right-0 w-1/2 h-full bg-yellow-400 transform skew-x-12 translate-x-20 opacity-90"></div>
    <div class="absolute top-0 right-0 w-32 h-full bg-red-500 transform skew-x-12 translate-x-40"></div>
    
    <!-- Main content -->
    <div class="relative z-10 h-full flex flex-col justify-between p-6 md:p-12">
      
      <!-- Top section -->
      <div class="flex justify-between items-start">
        <div>
          <div class="text-xs tracking-widest text-gray-400 mb-2">[ EXPERIMENTING ]</div>
          <h1 class="text-6xl md:text-9xl font-black tracking-tighter leading-none">
            MUSSE<br/>
            <span class="text-yellow-400">JUSSE</span>
          </h1>
        </div>
        <div class="text-right">
          <div class="text-xs text-gray-500">EST. 2024</div>
          <div class="text-xs text-gray-500">V3.0</div>
        </div>
      </div>
      
      <!-- Middle section -->
      <div class="flex flex-col md:flex-row gap-8 md:gap-16 items-start md:items-end">
        <div class="flex-1">
          <div class="border-l-4 border-yellow-400 pl-4 py-2">
            <p class="text-lg md:text-xl text-gray-300 max-w-lg">
              Building and experimenting with
              <span class="text-white font-bold">cutting-edge technology</span> 
              and modern frameworks.
            </p>
          </div>
        </div>
        
        <!-- Project box -->
        <div class="bg-white text-black p-6 md:p-8 max-w-sm w-full">
          <div class="flex justify-between items-start mb-4">
            <span class="text-xs tracking-widest text-gray-500">FEATURED PROJECT</span>
            <span class="text-yellow-400 text-2xl">→</span>
          </div>
          <a href="https://roundest.mussejusse.com" target="_blank" rel="noreferrer" class="block text-2xl md:text-3xl font-black hover:text-yellow-500 transition-colors">
            ROUNDEST<br/>POKEMON
          </a>
          <div class="mt-4 text-xs text-gray-600 leading-relaxed">
            Next.JS 16 // Cache Components // Server Actions // KV Store
          </div>
        </div>
      </div>
      
      <!-- Bottom section -->
      <div class="flex justify-between items-end">
        <div class="flex gap-6">
          <a href="https://bsky.app/profile/mussejusse.com" target="_blank" rel="noreferrer" class="group flex items-center gap-2 text-gray-400 hover:text-yellow-400 transition-colors">
            <span class="w-8 h-8 border border-current flex items-center justify-center text-xs">BS</span>
            <span class="text-xs tracking-wider hidden md:block">BLUESKY</span>
          </a>
          <a href="https://github.com/MusseJusse" target="_blank" rel="noreferrer" class="group flex items-center gap-2 text-gray-400 hover:text-yellow-400 transition-colors">
            <span class="w-8 h-8 border border-current flex items-center justify-center text-xs">GH</span>
            <span class="text-xs tracking-wider hidden md:block">GITHUB</span>
          </a>
          <a href="https://vercel.com" target="_blank" rel="noreferrer" class="group flex items-center gap-2 text-gray-400 hover:text-yellow-400 transition-colors">
            <span class="w-8 h-8 border border-current flex items-center justify-center text-xs">VC</span>
            <span class="text-xs tracking-wider hidden md:block">VERCEL</span>
          </a>
        </div>
        
        <div class="text-right">
          <div class="text-xs text-gray-600 tracking-widest">
            HOSTED ON VERCEL
          </div>
          <div class="text-xs text-gray-600">
            SOURCE ON GITHUB
          </div>
        </div>
      </div>
    </div>
    
    <!-- Corner accents -->
    <div class="absolute top-0 left-0 w-4 h-4 border-t-4 border-l-4 border-yellow-400"></div>
    <div class="absolute top-0 right-0 w-4 h-4 border-t-4 border-r-4 border-yellow-400"></div>
    <div class="absolute bottom-0 left-0 w-4 h-4 border-b-4 border-l-4 border-yellow-400"></div>
    <div class="absolute bottom-0 right-0 w-4 h-4 border-b-4 border-r-4 border-yellow-400"></div>
  </div>
</Layout>
