---
import Layout from "../layouts/main.astro";
---

<Layout>
  <div
    class="site relative flex min-h-[100dvh] flex-col overflow-x-clip bg-[#fbfbfa] font-sans text-[#131313]"
  >
    <div
      class="mx-auto flex w-full max-w-[1200px] flex-1 flex-col px-5 md:px-12"
    >
      <!-- hero -->
      <section
        class="flex flex-1 flex-col justify-center pb-6 pt-10 md:pb-10 md:pt-24"
      >
        <h1
          class="m-0 text-[clamp(84px,26vw,168px)] font-black uppercase leading-[0.88] tracking-[-0.05em] md:text-[clamp(56px,14cqi,168px)]"
        >
          <h1
            class="m-0 text-[clamp(84px,26vw,168px)] font-black uppercase leading-[0.88] tracking-[-0.05em] md:text-[clamp(56px,14cqi,168px)]"
          >
            Musse<br />
            <span class="text-[#ff5a36]">Jusse.</span>
          </h1>
          <p
            class="mono mt-6 max-w-[46ch] text-[12px] leading-relaxed text-[#6b6b67] md:text-[13px]"
          >
            I like building things. Here are a few of my projects.
          </p>
        </h1>

        <!-- activity line: one orange dot walks the hairline -->
        <div
          class="pulse relative mx-0 my-8 h-[2px] rounded bg-[#e7e7e4]"
          aria-hidden="true"
        >
          <span class="pulse-track">
            <span class="pulse-dot"></span>
          </span>
        </div>

        <!-- project rows -->
        <main class="pb-2">
          <a
            href="https://cutest.mussejusse.com"
            target="_blank"
            rel="noopener noreferrer"
            class="row group relative -mt-px grid grid-cols-[1fr_auto] items-center gap-x-5 gap-y-1 border-b border-t border-[#e7e7e4] px-4 py-6 no-underline transition-colors duration-[180ms] hover:bg-white focus-visible:bg-white focus-visible:outline-none md:grid-cols-[1fr_auto_auto] md:py-8"
          >
            <span
              class="text-[clamp(26px,4.8cqi,44px)] font-extrabold leading-none tracking-[-0.035em] text-[#131313]"
            >
              Cutest Pok&eacute;mon
            </span>
            <span
              class="mono hidden text-[10px] tracking-[0.1em] text-[#8a8a86] md:block"
            >
              next.js 16 &middot; 2026
            </span>
            <span
              class="justify-self-end text-[20px] text-[#b3b3af] transition-[transform,color] duration-[220ms] group-hover:translate-x-1.5 group-hover:text-[#131313] group-focus-visible:translate-x-1.5 group-focus-visible:text-[#131313]"
              aria-hidden="true">&rarr;</span
            >
          </a>

          <a
            href="https://models.mussejusse.com"
            target="_blank"
            rel="noopener noreferrer"
            class="row group relative -mt-px grid grid-cols-[1fr_auto] items-center gap-x-5 gap-y-1 border-y border-[#e7e7e4] px-4 py-6 no-underline transition-colors duration-[180ms] hover:bg-white focus-visible:bg-white focus-visible:outline-none md:grid-cols-[1fr_auto_auto] md:py-8"
          >
            <span
              class="text-[clamp(26px,4.8cqi,44px)] font-extrabold leading-none tracking-[-0.035em] text-[#131313]"
            >
              Models
            </span>
            <span
              class="mono hidden text-[10px] tracking-[0.1em] text-[#8a8a86] md:block"
            >
              astro &middot; 2026
            </span>
            <span
              class="justify-self-end text-[20px] text-[#b3b3af] transition-[transform,color] duration-[220ms] group-hover:translate-x-1.5 group-hover:text-[#131313] group-focus-visible:translate-x-1.5 group-focus-visible:text-[#131313]"
              aria-hidden="true">&rarr;</span
            >
          </a>

          <a
            href="https://byrubydesigns.com"
            target="_blank"
            rel="noopener noreferrer"
            class="row group relative -mt-px grid grid-cols-[1fr_auto] items-center gap-x-5 gap-y-1 border-y border-[#e7e7e4] px-4 py-6 no-underline transition-colors duration-[180ms] hover:bg-white focus-visible:bg-white focus-visible:outline-none md:grid-cols-[1fr_auto_auto] md:py-8"
          >
            <span
              class="text-[clamp(26px,4.8cqi,44px)] font-extrabold leading-none tracking-[-0.035em] text-[#131313]"
            >
              By Ruby Designs
            </span>
            <span
              class="mono hidden text-[10px] tracking-[0.1em] text-[#8a8a86] md:block"
            >
              astro &middot; 2026
            </span>
            <span
              class="justify-self-end text-[20px] text-[#b3b3af] transition-[transform,color] duration-[220ms] group-hover:translate-x-1.5 group-hover:text-[#131313] group-focus-visible:translate-x-1.5 group-focus-visible:text-[#131313]"
              aria-hidden="true">&rarr;</span
            >
          </a>
        </main>

        <!-- footer -->
        <footer
          class="mono mt-auto flex flex-wrap items-baseline justify-between gap-3 pb-10 pt-8 text-[11px] uppercase tracking-[0.14em]"
        >
          <a
            href="https://github.com/MusseJusse"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#131313] no-underline transition-colors duration-150 hover:text-[#ff5a36]"
            >GitHub &nearr;</a
          >
          <a
            href="https://bsky.app/profile/mussejusse.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#131313] no-underline transition-colors duration-150 hover:text-[#ff5a36]"
            >Bluesky &nearr;</a
          >
        </footer>
      </section>

      <style>
        .mono {
          font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        }
        /* underline sweep on rows */
        .row::after {
          content: "";
          position: absolute;
          left: 16px;
          right: 16px;
          bottom: -1px;
          height: 2px;
          background: #131313;
          transform: scaleX(0);
          transform-origin: left;
          transition: transform 240ms cubic-bezier(0.23, 1, 0.32, 1);
        }
        .row:hover::after,
        .row:focus-visible::after {
          transform: scaleX(1);
        }

        /* walking dot on the hairline. the track spans the full line, so the
         dot's walk is a percentage of the line itself and can never end up
         past the right edge, whatever the viewport is. */
        .pulse-track {
          position: absolute;
          inset: 0;
          display: block;
        }
        .pulse-dot {
          position: absolute;
          top: -3.5px;
          left: 0;
          width: 9px;
          height: 9px;
          border-radius: 50%;
          background: #ff5a36;
        }
        @media (prefers-reduced-motion: no-preference) {
          .pulse-track {
            animation: pulse-walk 6s cubic-bezier(0.77, 0, 0.175, 1) infinite
              alternate;
          }
          @keyframes pulse-walk {
            0% {
              transform: translateX(0.2%);
            }
            14% {
              transform: translateX(14%);
            }
            32% {
              transform: translateX(16%);
            }
            58% {
              transform: translateX(84%);
            }
            72% {
              transform: translateX(86%);
            }
            100% {
              transform: translateX(calc(100% - 9px));
            }
          }
        }
        @media (prefers-reduced-motion: reduce) {
          .pulse-track {
            transform: translateX(50%);
          }
        }
      </style>
    </div>
  </div>
</Layout>
