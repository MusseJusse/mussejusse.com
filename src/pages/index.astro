---
import Layout from "../layouts/main.astro";
---

<Layout>
  <div
    class="field-page relative min-h-screen overflow-hidden bg-[#101014] font-sans text-[#ece7db]"
  >
    <!-- reactive dot field: canvas behind everything -->
    <canvas id="dot-field" class="absolute inset-0 z-0 block" aria-hidden="true"
    ></canvas>

    <div
      class="relative z-10 flex min-h-screen flex-col px-6 py-6 md:px-14 md:py-8"
    >
      <!-- top bar -->
      <header
        class="mono flex items-baseline justify-between text-[11px] uppercase tracking-[0.18em] text-[#6e6e78]"
      >
        <a href="/" class="no-underline transition-colors hover:text-[#ece7db]"
          >mussejusse.com</a
        >
        <p>moves when you do</p>
      </header>

      <!-- hero -->
      <div class="flex flex-1 flex-col justify-center py-16 md:py-24">
        <h1
          class="m-0 select-none text-[clamp(56px,13vw,190px)] font-black uppercase leading-[0.88] tracking-[-0.05em] text-[#f4efe6]"
        >
          MU<span class="text-[#ff5a36]">.</span>SSE<br />
          JUSSE
        </h1>
        <p
          class="mt-7 max-w-[38ch] text-[clamp(14px,1.9vw,19px)] leading-relaxed text-[#8d8d97] md:mt-9"
        >
          Small experiments with a habit of staying online. Two are live right
          now.
        </p>
      </div>

      <!-- project panels -->
      <div class="grid max-w-[1020px] grid-cols-1 gap-4 md:grid-cols-2">
        <a
          href="https://roundest.mussejusse.com"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-start justify-between gap-5 border border-[#2d2d36] bg-[#16161c]/90 px-6 py-6 no-underline transition-[border-color,transform] duration-150 hover:-translate-y-0.5 hover:border-[#ff5a36] focus-visible:-translate-y-0.5 focus-visible:border-[#ff5a36] focus-visible:outline-none"
        >
          <span>
            <span
              class="mono block text-[10px] uppercase tracking-[0.14em] text-[#55555f]"
            >
              Next.js 16 · cache components · KV
            </span>
            <span
              class="mt-1.5 block text-[21px] font-extrabold tracking-[-0.02em] text-[#ece7dc] transition-colors group-hover:text-[#f4efe6] md:text-[24px]"
            >
              Roundest Pok&eacute;mon
            </span>
            <span
              class="mt-1.5 block text-[12px] leading-relaxed text-[#77777f]"
            >
              Which one is rounder? Settled by data, not vibes.
            </span>
          </span>
          <span
            class="mt-1 text-xl leading-none text-[#ff5a36]"
            aria-hidden="true">&rarr;</span
          >
        </a>

        <a
          href="https://models.mussejusse.com"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-start justify-between gap-5 border border-[#2d2d36] bg-[#16161c]/90 px-6 py-6 no-underline transition-[border-color,transform] duration-150 hover:-translate-y-0.5 hover:border-[#ff5a36] focus-visible:-translate-y-0.5 focus-visible:border-[#ff5a36] focus-visible:outline-none"
        >
          <span>
            <span
              class="mono block text-[10px] uppercase tracking-[0.14em] text-[#55555f]"
            >
              Astro · static · edge
            </span>
            <span
              class="mt-1.5 block text-[21px] font-extrabold tracking-[-0.02em] text-[#ece7dc] transition-colors group-hover:text-[#f4efe6] md:text-[24px]"
            >
              Models
            </span>
            <span
              class="mt-1.5 block text-[12px] leading-relaxed text-[#77777f]"
            >
              The model catalogue, pared back to what matters.
            </span>
          </span>
          <span
            class="mt-1 text-xl leading-none text-[#ff5a36]"
            aria-hidden="true">&rarr;</span
          >
        </a>
      </div>

      <!-- footer -->
      <footer
        class="mono flex flex-wrap items-baseline justify-between gap-3 pt-10 text-[11px] uppercase tracking-[0.16em] text-[#55555f]"
      >
        <span>hosted on vercel</span>
        <span>
          <a
            href="https://github.com/MusseJusse"
            class="no-underline transition-colors hover:text-[#ff5a36]"
            >GitHub &nearr;</a
          >
          <span class="px-2 opacity-50">/</span>
          <a
            href="https://bsky.app/profile/mussejusse.com"
            class="no-underline transition-colors hover:text-[#ff5a36]"
            >Bluesky &nearr;</a
          >
        </span>
      </footer>
    </div>

    <style>
      .mono {
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      }
    </style>

    <script is:inline>
      const canvas = document.getElementById("dot-field");
      const ctx = canvas.getContext("2d");
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const GAP = 26;
      const RADIUS = 120;
      const PUSH = 26;

      let dots = [];
      let w = 0;
      let h = 0;
      let raf = 0;
      let px = -9999;
      let py = -9999;
      let lastW = 0;
      let lastH = 0;

      function build() {
        const rect = canvas.getBoundingClientRect();
        if (rect.width < 10 || rect.height < 10) return;
        if (
          Math.abs(rect.width - lastW) < 1 &&
          Math.abs(rect.height - lastH) < 1
        ) {
          return;
        }
        lastW = rect.width;
        lastH = rect.height;
        const dpr = window.devicePixelRatio || 1;
        w = rect.width;
        h = rect.height;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const gap = Math.max(GAP, Math.sqrt((w * h) / 9000));
        dots = [];
        for (let gy = gap / 2; gy < h; gy += gap) {
          for (let gx = gap / 2; gx < w; gx += gap) {
            dots.push({ rx: gx, ry: gy, ox: 0, oy: 0, vx: 0, vy: 0 });
          }
        }
      }

      function drawStatic() {
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = "rgba(70, 70, 79, 0.55)";
        for (const d of dots) {
          ctx.beginPath();
          ctx.arc(d.rx, d.ry, 2, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      function step() {
        ctx.clearRect(0, 0, w, h);

        for (const d of dots) {
          const dx = d.rx - px;
          const dy = d.ry - py;
          const dist = Math.sqrt(dx * dx + dy * dy);

          let tx = 0;
          let ty = 0;

          if (dist < RADIUS && dist > 0.0001) {
            const force = (1 - dist / RADIUS) * PUSH;
            tx = (dx / dist) * force;
            ty = (dy / dist) * force;
          }

          d.vx += (tx - d.ox) * 0.08;
          d.vy += (ty - d.oy) * 0.08;
          d.vx *= 0.86;
          d.vy *= 0.86;
          d.ox += d.vx;
          d.oy += d.vy;

          const n = Math.sqrt(d.ox * d.ox + d.oy * d.oy);
          const warm = Math.min(1, n / 14);
          const r = Math.round(70 + 185 * warm);
          const g = Math.round(70 + 20 * warm);
          const b = Math.round(79 - 25 * warm);
          const a = 0.55 + warm * 0.45;

          ctx.fillStyle = "rgba(" + r + "," + g + "," + b + "," + a + ")";
          ctx.beginPath();
          ctx.arc(d.rx + d.ox, d.ry + d.oy, 2 + warm * 0.6, 0, Math.PI * 2);
          ctx.fill();
        }

        raf = requestAnimationFrame(step);
      }

      window.addEventListener(
        "pointermove",
        (e) => {
          px = e.clientX;
          py = e.clientY;
          if (!raf && !reduced) {
            raf = requestAnimationFrame(step);
          }
        },
        { passive: true },
      );

      window.addEventListener("pointerleave", () => {
        px = -9999;
        py = -9999;
      });

      document.addEventListener("visibilitychange", () => {
        if (document.hidden || reduced) {
          cancelAnimationFrame(raf);
          raf = 0;
        } else if (!raf) {
          raf = requestAnimationFrame(step);
        }
      });

      window.addEventListener("resize", build);
      for (const delay of [150, 400, 900, 1800, 3600]) {
        window.setTimeout(build, delay);
      }

      build();
      if (reduced) {
        drawStatic();
      } else {
        raf = requestAnimationFrame(step);
      }
    </script>
  </div>
</Layout>
