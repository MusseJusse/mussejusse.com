---
import Layout from "../layouts/main.astro";

const projects = [
  {
    name: "Atlas",
    description: "Compare AI model intelligence, cost, and speed.",
    domain: "atlas.mussejusse.com",
    href: "https://atlas.mussejusse.com",
  },
  {
    name: "By Ruby Designs",
    description: "Tattoo, painting, and drawing work in Edinburgh.",
    domain: "byrubydesigns.com",
    href: "https://byrubydesigns.com",
  },
  {
    name: "Cutest Pokémon",
    description: "Head-to-head voting and live favourites ranking.",
    domain: "cutest.mussejusse.com",
    href: "https://cutest.mussejusse.com",
  },
];
---

<Layout>
  <div class="poster">
    <header class="cb-topbar">
      <nav class="cb-nav" aria-label="Elsewhere">
        <a
          href="https://github.com/MusseJusse"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub<span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a
          href="https://bsky.app/profile/mussejusse.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          Bluesky<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </nav>
    </header>

    <main class="cb-main">
      <section class="cb-hero" aria-labelledby="site-title">
        <h1 class="cb-h1" id="site-title">
          <span class="cb-first">Musse</span>{" "}<span class="cb-last"
            >Jusse</span
          >
        </h1>
        <p class="cb-bio">
          I like building things. Here are a few of my projects.
        </p>
      </section>

      <div class="cb-horizon" aria-hidden="true">
        <span class="cb-horizon-fill"></span>
      </div>

      <section class="cb-cols" aria-label="Projects">
        {
          projects.map((project) => (
            <a
              class="cb-col"
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <h2 class="cb-col-title">{project.name}</h2>
              <div class="cb-col-meta">
                <p class="cb-col-desc">{project.description}</p>
                <span class="cb-col-url">
                  <span>{project.domain}</span>
                  <svg
                    class="cb-arrow"
                    width="13"
                    height="13"
                    viewBox="0 0 13 13"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M3 10L10 3M10 3H4.5M10 3V8.5"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="square"
                    />
                  </svg>
                </span>
              </div>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          ))
        }
      </section>
    </main>
  </div>

  <style>
    .poster {
      min-height: 100dvh;
      width: 100%;
      background:
        radial-gradient(
          90% 70% at 12% 0%,
          rgba(62, 104, 255, 0.22),
          transparent 62%
        ),
        var(--cobalt);
      color: var(--ink);
      display: grid;
      grid-template-rows: auto 1fr;
      overflow-x: clip;
    }

    /* Top nav bar: first in DOM and first visually across all viewports */
    .cb-topbar {
      padding: calc(env(safe-area-inset-top) + 12px)
        max(24px, env(safe-area-inset-right)) 0
        max(24px, env(safe-area-inset-left));
    }

    .cb-nav {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 20px;
      margin-inline-end: -4px;
      font-size: 15px;
      font-weight: 600;
    }

    .cb-nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 4px;
      color: var(--ink);
      text-decoration: none;
      position: relative;
      transition: color 150ms ease;
    }

    .cb-nav a::after {
      content: "";
      position: absolute;
      left: 4px;
      right: 4px;
      bottom: 8px;
      height: 2px;
      background: var(--accent);
      scale: 0 1;
      transform-origin: left;
      transition: scale 180ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    @media (hover: hover) and (pointer: fine) {
      .cb-nav a:hover {
        color: var(--accent);
      }

      .cb-nav a:hover::after {
        scale: 1 1;
      }
    }

    .cb-nav a:active {
      color: var(--accent);
    }

    .cb-nav a:focus-visible {
      color: var(--accent);
      outline: 2px solid var(--accent);
      outline-offset: 2px;
      border-radius: 2px;
    }

    /* Main landmark wraps hero, horizon rule, and projects */
    .cb-main {
      display: grid;
      grid-template-rows: auto auto 1fr;
    }

    .cb-hero {
      padding: 12px max(24px, env(safe-area-inset-right)) 24px
        max(24px, env(safe-area-inset-left));
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 16px;
    }

    .cb-h1 {
      font-size: clamp(78px, 23vw, 108px);
      font-weight: 700;
      line-height: 0.86;
      letter-spacing: -0.048em;
      margin-left: -0.022em;
      color: var(--ink-bright);
    }

    .cb-first,
    .cb-last {
      display: block;
    }

    .cb-bio {
      font-size: 16px;
      line-height: 1.42;
      color: var(--ink-muted);
      max-width: 34ch;
      text-wrap: pretty;
    }

    /* Unified 3px marigold horizon line across all viewports */
    .cb-horizon {
      position: relative;
      height: 3px;
      background: var(--line);
      overflow: hidden;
      transform: translateZ(0);
    }

    .cb-horizon-fill {
      display: block;
      width: 100%;
      height: 100%;
      background: var(--accent);
      transform-origin: left;
    }

    @media (prefers-reduced-motion: no-preference) {
      .cb-horizon-fill {
        animation: cb-horizon-draw 620ms cubic-bezier(0.22, 1, 0.36, 1)
          backwards;
      }

      @keyframes cb-horizon-draw {
        from {
          scale: 0 1;
        }
      }
    }

    /* Project stack and columns */
    .cb-cols {
      display: grid;
      grid-template-columns: 1fr;
    }

    .cb-col {
      --col-bg: transparent;
      --col-fg: var(--ink);
      --col-muted: var(--ink-muted);
      --col-accent: var(--accent);

      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 10px;
      padding: 18px max(24px, env(safe-area-inset-right)) 18px
        max(24px, env(safe-area-inset-left));
      border-bottom: 1px solid var(--line);
      background-color: var(--col-bg);
      color: var(--col-fg);
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
    }

    /* Kinetic top seam strip: zips across the active column while colour swaps immediately */
    .cb-col::before {
      content: "";
      position: absolute;
      inset: 0 0 auto 0;
      height: 3px;
      background: var(--cobalt-deep);
      transform-origin: left;
      scale: 0 1;
      transition: scale 130ms ease-out;
      pointer-events: none;
    }

    .cb-col:last-child {
      border-bottom: 0;
      padding-bottom: calc(env(safe-area-inset-bottom) + 24px);
    }

    .cb-col-title {
      font-size: clamp(32px, 8.2vw, 38px);
      font-weight: 700;
      line-height: 0.96;
      letter-spacing: -0.032em;
      margin-left: -0.03em;
      text-wrap: balance;
    }

    .cb-col-meta {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .cb-col-desc {
      font-size: 15.5px;
      line-height: 1.42;
      color: var(--col-muted);
      max-width: 34ch;
      text-wrap: pretty;
    }

    .cb-col-url {
      display: inline-flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: 7px;
      font-size: 14.5px;
      font-weight: 600;
      color: var(--col-accent);
    }

    .cb-col-url > span {
      min-width: 0;
      overflow-wrap: anywhere;
    }

    .cb-arrow {
      display: inline-block;
      flex-shrink: 0;
      transition: translate 180ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Instant AAA colour flip + kinetic seam strip & arrow nudge (zero low-contrast frames) */
    @media (hover: hover) and (pointer: fine) {
      .cb-col:hover {
        --col-bg: var(--accent);
        --col-fg: var(--cobalt-deep);
        --col-muted: var(--cobalt-muted);
        --col-accent: var(--cobalt-deep);
      }

      .cb-col:hover::before {
        scale: 1 1;
        transition: scale 200ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .cb-col:hover .cb-arrow {
        translate: 3px -3px;
      }

      .cb-col:hover ::selection {
        background-color: var(--cobalt-deep);
        color: var(--accent);
      }
    }

    .cb-col:is(:active, :focus-visible) {
      --col-bg: var(--accent);
      --col-fg: var(--cobalt-deep);
      --col-muted: var(--cobalt-muted);
      --col-accent: var(--cobalt-deep);
    }

    .cb-col:is(:active, :focus-visible)::before {
      scale: 1 1;
    }

    .cb-col:is(:active, :focus-visible) .cb-arrow {
      translate: 3px -3px;
    }

    .cb-col:is(:active, :focus-visible) ::selection {
      background-color: var(--cobalt-deep);
      color: var(--accent);
    }

    .cb-col:focus-visible {
      outline: 3px solid var(--cobalt-deep);
      outline-offset: -3px;
    }

    /* Portrait tablet (600px-859px and portrait tablets up to 1199px): 2-column timetable */
    @media (min-width: 600px) and (max-width: 859px),
      (min-width: 860px) and (max-width: 1199px) and (orientation: portrait) {
      .cb-topbar {
        display: grid;
        grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
        column-gap: 32px;
        padding: calc(env(safe-area-inset-top) + 22px)
          max(clamp(28px, 5.5vw, 56px), env(safe-area-inset-right)) 0
          max(clamp(28px, 5.5vw, 56px), env(safe-area-inset-left));
      }

      .cb-nav {
        grid-column: 2;
        justify-content: flex-start;
        margin-inline-start: -4px;
        margin-inline-end: 0;
        gap: 24px;
        font-size: 16px;
      }

      .cb-main {
        grid-template-rows: 1fr auto auto;
      }

      .cb-hero {
        padding: 28px
          max(clamp(28px, 5.5vw, 56px), env(safe-area-inset-right)) 40px
          max(clamp(28px, 5.5vw, 56px), env(safe-area-inset-left));
        display: grid;
        grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
        column-gap: 32px;
        align-items: last baseline;
        align-content: end;
      }

      .cb-h1 {
        font-size: clamp(86px, 13.5vw, 132px);
        line-height: 0.88;
      }

      .cb-bio {
        font-size: clamp(18px, 2.2vw, 21px);
        max-width: 28ch;
      }

      .cb-col {
        display: grid;
        grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
        align-items: first baseline;
        column-gap: 32px;
        padding: clamp(32px, 4vh, 44px)
          max(clamp(28px, 5.5vw, 56px), env(safe-area-inset-right))
          clamp(32px, 4vh, 44px)
          max(clamp(28px, 5.5vw, 56px), env(safe-area-inset-left));
      }

      .cb-col:last-child {
        padding-bottom: calc(
          env(safe-area-inset-bottom) + clamp(36px, 4.5vh, 52px)
        );
      }

      .cb-col-title {
        font-size: clamp(36px, 5.2vw, 48px);
      }

      .cb-col-meta {
        gap: 10px;
      }

      .cb-col-desc {
        font-size: clamp(16.5px, 2vw, 19px);
      }

      .cb-col-url {
        font-size: clamp(15.5px, 1.8vw, 17px);
      }
    }

    /* Desktop poster spread: sky holds vertical breathing room, columns stay taut */
    @media (min-width: 860px) and (orientation: landscape),
      (min-width: 1200px) {
      .cb-topbar {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        padding: calc(env(safe-area-inset-top) + clamp(14px, 3vh, 28px)) 0 0;
      }

      .cb-nav {
        grid-column: 3;
        justify-content: flex-start;
        gap: 28px;
        margin-inline-end: 0;
        padding-left: clamp(24px, 3.6vw, 52px);
        padding-right: max(
          clamp(32px, 4.8vw, 68px),
          env(safe-area-inset-right)
        );
        margin-inline-start: -4px;
        font-size: clamp(15px, 1.25vw, 18px);
      }

      .cb-main {
        grid-template-rows: minmax(170px, 1fr) auto auto;
      }

      .cb-hero {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        align-items: last baseline;
        align-content: end;
        padding: clamp(16px, 3vh, 32px) 0 clamp(24px, 4.6vh, 48px);
        gap: 0;
      }

      .cb-h1 {
        grid-column: 1 / 3;
        padding-left: max(
          clamp(32px, 4.8vw, 68px),
          env(safe-area-inset-left)
        );
        padding-right: 24px;
        font-size: clamp(64px, min(10.6vw, 20vh), 180px);
        line-height: 0.9;
        letter-spacing: -0.048em;
      }

      .cb-first,
      .cb-last {
        display: inline;
      }

      .cb-bio {
        grid-column: 3;
        padding-left: clamp(24px, 3.6vw, 52px);
        padding-right: max(
          clamp(32px, 4.8vw, 68px),
          env(safe-area-inset-right)
        );
        font-size: clamp(16px, 1.4vw, 21px);
        max-width: 30ch;
      }

      .cb-cols {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .cb-col {
        justify-content: space-between;
        gap: clamp(32px, 6.2vh, 68px);
        padding: clamp(24px, 4.2vh, 44px) clamp(24px, 3.6vw, 52px)
          calc(env(safe-area-inset-bottom) + clamp(24px, 4.6vh, 48px));
        border-bottom: 0;
        border-right: 1px solid var(--line);
      }

      .cb-col:first-child {
        padding-left: max(
          clamp(32px, 4.8vw, 68px),
          env(safe-area-inset-left)
        );
      }

      .cb-col:last-child {
        border-right: 0;
        padding-right: max(
          clamp(32px, 4.8vw, 68px),
          env(safe-area-inset-right)
        );
        padding-bottom: calc(
          env(safe-area-inset-bottom) + clamp(24px, 4.6vh, 48px)
        );
      }

      .cb-col-title {
        font-size: clamp(34px, 4vw, 58px);
        line-height: 0.94;
      }

      .cb-col-meta {
        gap: 10px;
      }

      .cb-col-desc {
        font-size: clamp(15px, 1.3vw, 19px);
        line-height: 1.44;
        max-width: 34ch;
      }

      .cb-col-url {
        font-size: clamp(14px, 1.18vw, 17px);
      }
    }
  </style>
</Layout>
